{
  "entities": {
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Real-time user or admin message sent in the community support chat",
      "type": "object",
      "properties": {
        "senderName": { "type": "string", "maxLength": 60 },
        "senderEmail": { "type": "string", "maxLength": 120 },
        "text": { "type": "string", "maxLength": 1000 },
        "isAdmin": { "type": "boolean" },
        "timestamp": { "type": "number" }
      },
      "required": ["senderName", "text", "timestamp"]
    },
    "AppReview": {
      "title": "AppReview",
      "description": "User rating and feedback for an APK application",
      "type": "object",
      "properties": {
        "appId": { "type": "string", "maxLength": 128 },
        "appName": { "type": "string", "maxLength": 120 },
        "userName": { "type": "string", "maxLength": 60 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 2000 },
        "timestamp": { "type": "number" }
      },
      "required": ["appId", "userName", "rating", "comment", "timestamp"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "User contact inquiries or support messages",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "subject": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 3000 },
        "timestamp": { "type": "number" }
      },
      "required": ["name", "email", "message", "timestamp"]
    },
    "AppItem": {
      "title": "AppItem",
      "description": "Android APK application details and mirrors",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 120 },
        "slug": { "type": "string", "maxLength": 120 },
        "version": { "type": "string", "maxLength": 30 },
        "apkFileUrl": { "type": "string" },
        "downloadCount": { "type": "number" }
      },
      "required": ["name", "slug"]
    }
  },
  "firestore": {
    "/chat_messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Live real-time community chat messages"
    },
    "/app_reviews/{reviewId}": {
      "schema": "AppReview",
      "description": "User reviews and star ratings per APK"
    },
    "/contact_messages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Contact form submissions"
    },
    "/apps/{appId}": {
      "schema": "AppItem",
      "description": "Cataloged APK applications"
    }
  }
}
